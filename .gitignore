# Configurare locala cu secrete - .env.example ramane versionat
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Stare runtime a aplicatiei
data/state.json
data/*.json.tmp

# PyInstaller - artefacte de build (.exe). Vezi build_exe.bat
build/
dist/
desene/
partea scrisa/
*.spec

# Backup-uri de stare generate la teste
data/*.json.backup*

# misc/ tine doar SURSE (SVG, .py, .md, .csv). Ignoram:
#  - PNG-urile generate din SVG (regenerabile prin Chrome headless)
#  - pozele/foto si modelele CAD (imagini binare mari, doar pt figurile lucrarii)
misc/*.png
misc/*.jpg
misc/*.jpeg

# IDE / editor
.vscode/
.idea/

# Fisiere temporare de lucru / analiza
p2_err.txt
*_err.txt
