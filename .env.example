# ============================================================
# Dropwise - sablon de configurare (.env.example)
# ============================================================
# Copiaza acest fisier in ".env" si completeaza valorile reale.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
#
# Fisierul .env NU se urca in git (vezi .gitignore).
# ============================================================

# ---------- Provisioning BLE ----------

# Modul de lucru al detectiei Bluetooth:
#   sim  - hub simulat, fara hardware (pentru dezvoltare / test UI)
#   real - hub fizic ESP32 prin bleak
DROPWISE_BLE_MODE=sim

# Durata unui scan BLE, in secunde.
DROPWISE_BLE_SCAN_DURATION=6

# Cat asteptam confirmarea conectarii WiFi de la ESP32, in secunde.
DROPWISE_BLE_CONFIRM_TIMEOUT=30

# ---------- Configurare Flask ----------

# Cheia secreta pentru semnarea sesiunilor. OBLIGATORIU schimbata in
# productie cu o valoare aleatoare lunga. Genereaza una cu:
#   python -c "import secrets; print(secrets.token_hex(32))"
DROPWISE_SECRET_KEY=dev-only-change-in-production

# Portul pe care asculta serverul web.
DROPWISE_PORT=5000
